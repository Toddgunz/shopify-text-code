{% doc %}
  @prompt
    Create a linked scrolling text block for the header that supports multiple messages and optional links.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign message_count = 0
  assign has_links = false
%}

{% style %}
  .ai-scrolling-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-scrolling-text-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    animation: ai-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-scrolling-text-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.text_spacing }}px;
    white-space: nowrap;
    padding-right: {{ block.settings.text_spacing }}px;
  }

  .ai-scrolling-text-item-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.font_weight }};
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    line-height: 1;
    text-decoration: none;
  }

  .ai-scrolling-text-item-{{ ai_gen_id }} > * {
    margin: 0;
  }

  .ai-scrolling-text-item-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-scrolling-text-item-{{ ai_gen_id }} a,
  .ai-scrolling-text-item-{{ ai_gen_id }}--link {
    color: {{ block.settings.link_color }};
    text-decoration: none;
  }

  .ai-scrolling-text-item-{{ ai_gen_id }}--link:hover {
    opacity: 0.75;
  }

  @keyframes ai-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-scrolling-text-wrapper-{{ ai_gen_id }}:hover {
    animation-play-state: {{ block.settings.pause_on_hover }};
  }
{% endstyle %}

<scrolling-text-{{ ai_gen_id }} class="ai-scrolling-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-scrolling-text-wrapper-{{ ai_gen_id }}">
    {% for duplicate in (1..2) %}
      <div class="ai-scrolling-text-content-{{ ai_gen_id }}" {% if duplicate > 1 %}aria-hidden="true"{% endif %}>
        {% for index in (1..5) %}
          {% liquid
            assign text_key = 'message_' | append: index
            assign link_key = 'link_' | append: index
            assign message_text = block.settings[text_key]
            assign message_link = block.settings[link_key]
          %}

          {% if message_text != blank %}
            {% assign message_count = message_count | plus: 1 %}

            {% if message_link != blank %}
              <a href="{{ message_link }}" class="ai-scrolling-text-item-{{ ai_gen_id }} ai-scrolling-text-item-{{ ai_gen_id }}--link">
                {{ message_text }}
              </a>
            {% else %}
              <span class="ai-scrolling-text-item-{{ ai_gen_id }}">
                {{ message_text }}
              </span>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</scrolling-text-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollingText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.duplicateContent();
      }

      duplicateContent() {
        const wrapper = this.querySelector('.ai-scrolling-text-wrapper-{{ ai_gen_id }}');
        const content = this.querySelector('.ai-scrolling-text-content-{{ ai_gen_id }}');

        if (wrapper && content) {
          const contentWidth = content.offsetWidth;
          const viewportWidth = this.offsetWidth;
          const duplicatesNeeded = Math.ceil(viewportWidth / Math.max(contentWidth, 1)) + 2;

          for (let i = wrapper.children.length; i < duplicatesNeeded; i++) {
            const clone = content.cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            wrapper.appendChild(clone);
          }
        }
      }
    }

    if (!customElements.get('scrolling-text-{{ ai_gen_id }}')) {
      customElements.define('scrolling-text-{{ ai_gen_id }}', ScrollingText{{ ai_gen_id }});
    }
  })();
</script>

