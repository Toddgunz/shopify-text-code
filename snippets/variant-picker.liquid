{%- doc -%}
Render the variant picker option selectors.

@param {object} product - the product for which to render the selector
@param {string} context - the context of the variant picker. Can be "main_product", "featured_product" or "quick_buy"
@param {string} [form_id] - the ID of the form that is listening
@param {boolean} [hide_sold_out_variants] - if set to true, the sold out or unavailable variants are hidden
@param {boolean} [separate_options] - if set to true, consecutive options are separated by a border
@param {string} [selector_style] - the selector style to use for the main selectors
@param {string} [swatch_selector_style] - the selector style to use for the dedicated swatch selectors
@param {string} [swatch_selector_size] - the size for the color selectors. Can be either "sm" or "lg"
@param {string} [block_selector_style] - the selector style to use for the dedicated block selectors
@param {string} [variant_image_options] - a list of option names for which to use the variant image selector mode
@param {object} [size_chart_page] - the page to use for the size chart
@param {string} [alignment] - the content alignment for options (can be "start", "center" or "end")
@param {object} [sibling_union_collection] - sibling collection metafield; when present with multiple products, union non-color options across siblings
@param {string} [sibling_managed_option_name] - Shopify option name handled by sibling color picker (excluded from union expansion)
@param {object} [block]
@param {object} [section]
{%- enddoc -%}

{%- liquid
  assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','
  assign size_label_list = 'general.label.size' | t | replace: ', ', ',' | downcase | split: ','
  assign variant_image_options = variant_image_options | replace: ', ', ',' | downcase | split: ','

  if context == 'main_product'
    assign is_main_product = true
  endif

  assign sibling_union_mode = false
  if sibling_union_collection != blank and sibling_union_collection.products.size > 1 and sibling_managed_option_name != blank
    assign sibling_union_mode = true
    assign sibling_managed_option_key = sibling_managed_option_name | downcase | strip
  endif
-%}

{%- unless product.has_only_default_variant -%}
  <variant-picker class="variant-picker" section-id="{{ section.id }}" form-id="{{ form_id }}" handle="{{ product.handle }}" {% if is_main_product %}update-url{% endif %}>
    {%- comment -%}
    The variant data is outputted as a JSON, which allows the theme to emit an event with the data when the variant changes. This must not be removed.
    {%- endcomment -%}
    <script data-variant type="application/json">
      {{- product.selected_or_first_available_variant | json -}}
    </script>

    {%- for option in product.options_with_values -%}
      {% liquid
        assign option_downcase = option.name | downcase
        assign resolved_option_selector_style = selector_style

        assign swatch_count = option.values | map: 'swatch' | compact | size

        if swatch_count > 0 and swatch_selector_style != 'none'
          # Use the swatch selector type only if we have at least one swatch and a supported swatch selector type
          assign resolved_option_selector_style = swatch_selector_style
        endif

        # Implementation note: if the option value has no native swatch, BUT that the option name matches a hardcoded list of color names,
        # we fallback to the legacy config-based system. This allows to keep compatibility with stores that were using the config-based, and
        # allow those merchants to upgrade to the new system at their own pace.
        if swatch_count == 0 and color_label_list contains option_downcase and swatch_selector_style != 'none'
          assign resolved_option_selector_style = swatch_selector_style
        endif

        if variant_image_options contains option_downcase
          assign resolved_option_selector_style = 'variant_image'
        endif

        assign option_use_sibling_union = false
        if sibling_union_mode
          assign opt_key = option.name | downcase | strip
          if opt_key != sibling_managed_option_key
            assign option_use_sibling_union = true
          endif
        endif

        assign vp_order_pipe = ''
        if option_use_sibling_union
          assign vp_seen = '|'
          for option_value in option.values
            assign vn = option_value.name | strip
            assign mark = '|' | append: vn | append: '|'
            unless vp_seen contains mark
              assign vp_order_pipe = vp_order_pipe | append: vn | append: '~~~'
              assign vp_seen = vp_seen | append: vn | append: '|'
            endunless
          endfor
          for sp in sibling_union_collection.products
            for sopt in sp.options_with_values
              if sopt.name == option.name
                for sib_ov in sopt.values
                  assign vn = sib_ov.name | strip
                  assign mark = '|' | append: vn | append: '|'
                  unless vp_seen contains mark
                    assign vp_order_pipe = vp_order_pipe | append: vn | append: '~~~'
                    assign vp_seen = vp_seen | append: vn | append: '|'
                  endunless
                endfor
              endif
            endfor
          endfor
          comment
            sort_natural still orders 10-16 before 6 (lexicographic). For Size options, walk a canonical US running
            half-size ladder so 6, 6.5... come before 10. Non-matching labels (e.g. EU sizes) append after, sort_natural.
          endcomment
          if size_label_list contains option_downcase
            assign canonical_running_sizes = '3,3.5,4,4.5,5,5.5,6,6.5,7,7.5,8,8.5,9,9.5,10,10.5,11,11.5,12,12.5,13,13.5,14,14.5,15,16' | split: ','
            assign size_ordered_pipe = ''
            for sz in canonical_running_sizes
              assign sz_mark = '|' | append: sz | append: '|'
              if vp_seen contains sz_mark
                assign size_ordered_pipe = size_ordered_pipe | append: sz | append: '~~~'
              endif
            endfor
            assign canonical_lookup = '|'
            for sz in canonical_running_sizes
              assign canonical_lookup = canonical_lookup | append: sz | append: '|'
            endfor
            assign union_names_temp = vp_order_pipe | split: '~~~' | compact
            assign extra_pipe = ''
            for name in union_names_temp
              assign name_mark = '|' | append: name | append: '|'
              unless canonical_lookup contains name_mark
                assign extra_pipe = extra_pipe | append: name | append: '~~~'
              endunless
            endfor
            assign extras_sorted = extra_pipe | split: '~~~' | compact | sort_natural
            assign base_ordered = size_ordered_pipe | split: '~~~' | compact
            assign vp_sorted_union_names = base_ordered | concat: extras_sorted
          else
            assign vp_sorted_union_names = vp_order_pipe | split: '~~~' | compact | sort_natural
          endif
        endif
      %}

      <fieldset class="variant-picker__option justify-{{ alignment }}">
        <div class="variant-picker__option-info {% if alignment == 'start' %}justify-between{% else %}justify-{{ alignment }}{% endif %}">
          <div class="h-stack gap-2">
            <legend class="text-subdued">{{ option.name }}:</legend>
            <span>{{ option.selected_value }}</span>
          </div>

          {%- if size_chart_page != blank and size_label_list contains option_downcase -%}
            {%- capture id -%}size-chart-{{ section.id }}-{{ block.id }}{%- endcapture -%}

            <button type="button" class="link subheading" aria-controls="{{ id | escape }}" aria-expanded="false">
              {{- 'product.general.size_chart' | t -}}
            </button>

            <x-drawer id="{{ id | escape }}" class="drawer color-scheme color-scheme--{{ settings.default_color_scheme.id }}">
              <span class="h5" slot="header">{{ size_chart_page.title }}</span>

              <div class="prose">
                {{- size_chart_page.content -}}
              </div>
            </x-drawer>
          {%- endif -%}
        </div>

        {%- if resolved_option_selector_style == 'dropdown' -%}
          <div class="relative">
            {%- capture popover_id -%}popover-variant-dropdown-{{ section.id }}-{{ product.id }}-{{ option.position }}{%- endcapture -%}

            <button type="button" class="select {% if settings.input_uppercase %}subheading{% endif %}" aria-controls="{{ popover_id }}" aria-expanded="false">
              <span id="{{ popover_id }}-selected-value">{{- option.selected_value -}}</span>
              {%- render 'icon' with 'chevron-down' -%}
            </button>

            <x-popover id="{{ popover_id }}" class="popover popover--w-full color-scheme color-scheme--{{ settings.default_color_scheme.id }}" close-on-listbox-change>
              <p class="h6" slot="header">{{ option.name }}</p>

              <div class="popover__value-list">
                {%- assign param_name = form_id | append: '-option' | append: option.position -%}

                {%- if option_use_sibling_union -%}
                  {%- assign expanded_option_names = vp_sorted_union_names -%}
                  {%- for value_name in expanded_option_names -%}
                    {%- if value_name == blank -%}{%- continue -%}{%- endif -%}
                    {%- liquid
                      assign matched_option_value = false
                      for option_value in option.values
                        assign ovn = option_value.name | strip
                        if ovn == value_name
                          assign matched_option_value = option_value
                          break
                        endif
                      endfor
                    -%}
                    {%- if matched_option_value != false -%}
                      {%- assign option_value = matched_option_value -%}
                      {%- capture option_markup -%}
                        <span {% if option_value.available == false %}class="line-through"{% endif %}>{{- option_value -}}</span>
                      {%- endcapture -%}

                      {%- if hide_sold_out_variants == false or option_value.available or option_value.selected -%}
                        {%- if is_main_product and option_value.product_url != blank -%}
                          <div class="popover__value-option">
                            {%- if option_value.selected -%}
                              <input class="sr-only" type="radio" id="{{ param_name }}-{{ option_value.id }}" form="{{ form_id }}" name="{{ param_name }}" data-option-position="{{ option.position }}" value="{{ option_value.id }}" checked>
                            {%- endif -%}

                            <a href="{{ option_value.variant.url | default: option_value.product_url }}" class="h-stack justify-between gap-2 link-faded-reverse">
                              {{- option_markup -}}
                            </a>
                          </div>
                        {%- else -%}
                          <label class="popover__value-option" for="{{ param_name }}-{{ option_value.id }}">
                            <input class="sr-only" type="radio" id="{{ param_name }}-{{ option_value.id }}" form="{{ form_id }}" name="{{ param_name }}" {% if option_value.product_url != blank %}data-product-url="{{ option_value.product_url | escape }}"{% endif %} data-option-position="{{ option.position }}" value="{{ option_value.id }}" {% if option_value.selected %}checked{% endif %}>
                            {{- option_markup -}}
                          </label>
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- assign ghost_aria_suffix = 'product.general.sibling_variant_unavailable' | t -%}
                      {%- assign ghost_aria = value_name | append: ': ' | append: ghost_aria_suffix -%}
                      <div class="popover__value-option" role="presentation">
                        <span class="line-through text-subdued" aria-label="{{ ghost_aria | escape }}">{{ value_name | escape }}</span>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- for option_value in option.values -%}
                    {%- capture option_markup -%}
                      <span {% if option_value.available == false %}class="line-through"{% endif %}>{{- option_value -}}</span>
                    {%- endcapture -%}

                    {%- if hide_sold_out_variants == false or option_value.available or option_value.selected -%}
                      {%- if is_main_product and option_value.product_url != blank -%}
                        <div class="popover__value-option">
                          {%- if option_value.selected -%}
                            <input class="sr-only" type="radio" id="{{ param_name }}-{{ option_value.id }}" form="{{ form_id }}" name="{{ param_name }}" data-option-position="{{ option.position }}" value="{{ option_value.id }}" checked>
                          {%- endif -%}

                          <a href="{{ option_value.variant.url | default: option_value.product_url }}" class="h-stack justify-between gap-2 link-faded-reverse">
                            {{- option_markup -}}
                          </a>
                        </div>
                      {%- else -%}
                        <label class="popover__value-option" for="{{ param_name }}-{{ option_value.id }}">
                          <input class="sr-only" type="radio" id="{{ param_name }}-{{ option_value.id }}" form="{{ form_id }}" name="{{ param_name }}" {% if option_value.product_url != blank %}data-product-url="{{ option_value.product_url | escape }}"{% endif %} data-option-position="{{ option.position }}" value="{{ option_value.id }}" {% if option_value.selected %}checked{% endif %}>
                          {{- option_markup -}}
                        </label>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </x-popover>
          </div>
        {%- else -%}
          {%- liquid
            case resolved_option_selector_style
              when 'swatch'
                case settings.color_swatch_shape
                  when 'circle'
                    if swatch_selector_size == 'sm'
                      assign list_classes = 'h-stack gap-3 wrap'
                    else
                      assign list_classes = 'h-stack gap-4 wrap'
                    endif

                  else
                    if swatch_selector_size == 'sm'
                      assign list_classes = 'h-stack gap-3 wrap'
                    else
                      assign list_classes = 'h-stack gap-4 wrap'
                    endif
                endcase
              when 'variant_image'
                assign list_classes = 'h-stack gap-1 wrap'
              else
                assign list_classes = 'h-stack gap-3 wrap'
            endcase
          -%}

          <div class="variant-picker__option-values {{ list_classes }}">
            {%- liquid
              assign name = form_id | append: '-option' | append: option.position
            -%}

            {%- if option_use_sibling_union -%}
              {%- assign expanded_option_names_grid = vp_sorted_union_names -%}
              {%- for value_name in expanded_option_names_grid -%}
                {%- if value_name == blank -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign matched_option_value = false
                  for option_value in option.values
                    assign ovn = option_value.name | strip
                    if ovn == value_name
                      assign matched_option_value = option_value
                      break
                    endif
                  endfor
                -%}
                {%- if matched_option_value != false -%}
                  {%- assign option_value = matched_option_value -%}
                  {%- if hide_sold_out_variants == false or option_value.available or option_value.selected -%}
                    {%- case resolved_option_selector_style -%}
                      {%- when 'variant_image' -%}
                        {%- render 'option-value', type: 'thumbnail', form: form_id, option_value: option_value, param_name: name, option_position: option.position, size: swatch_selector_size, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index -%}
                      {%- when 'swatch' -%}
                        {%- render 'option-value', type: 'swatch', form: form_id, option_value: option_value, param_name: name, option_position: option.position, size: swatch_selector_size, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index -%}
                      {%- when 'block' -%}
                        {%- render 'option-value', type: 'block', form: form_id, option_value: option_value, param_name: name, option_position: option.position, style: block_selector_style, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index -%}
                      {%- when 'block_swatch' -%}
                        {%- render 'option-value', type: 'block', form: form_id, option_value: option_value, param_name: name, option_position: option.position, style: block_selector_style, show_swatch: true, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index -%}
                    {%- endcase -%}
                  {%- endif -%}
                {%- else -%}
                  {%- case resolved_option_selector_style -%}
                    {%- when 'variant_image' -%}
                      {%- render 'variant-picker-sibling-ghost', label: value_name, selector_style: 'variant_image', swatch_selector_size: swatch_selector_size, block_selector_style: block_selector_style -%}
                    {%- when 'swatch' -%}
                      {%- render 'variant-picker-sibling-ghost', label: value_name, selector_style: 'swatch', swatch_selector_size: swatch_selector_size, block_selector_style: block_selector_style -%}
                    {%- when 'block' -%}
                      {%- render 'variant-picker-sibling-ghost', label: value_name, selector_style: 'block', swatch_selector_size: swatch_selector_size, block_selector_style: block_selector_style -%}
                    {%- when 'block_swatch' -%}
                      {%- render 'variant-picker-sibling-ghost', label: value_name, selector_style: 'block_swatch', swatch_selector_size: swatch_selector_size, block_selector_style: block_selector_style -%}
                  {%- endcase -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {% liquid
                for option_value in option.values
                  case resolved_option_selector_style
                    when 'variant_image'
                      render 'option-value', type: 'thumbnail', form: form_id, option_value: option_value, param_name: name, option_position: option.position, size: swatch_selector_size, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index
                    when 'swatch'
                      render 'option-value', type: 'swatch', form: form_id, option_value: option_value, param_name: name, option_position: option.position, size: swatch_selector_size, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index
                    when 'block'
                      render 'option-value', type: 'block', form: form_id, option_value: option_value, param_name: name, option_position: option.position, style: block_selector_style, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index
                    when 'block_swatch'
                      render 'option-value', type: 'block', form: form_id, option_value: option_value, param_name: name, option_position: option.position, style: block_selector_style, show_swatch: true, hide_if_disabled: hide_sold_out_variants, reload_page_for_combined_products: is_main_product, id_prefix: forloop.index
                  endcase
                endfor
              %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </fieldset>

      {%- if separate_options and forloop.last == false -%}
        <hr>
      {%- endif -%}
    {%- endfor -%}
  </variant-picker>
{%- endunless -%}
