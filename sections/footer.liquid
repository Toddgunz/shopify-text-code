{%- liquid
  assign faq_url = section.settings.faq_url
  assign contact_url = section.settings.contact_url
  assign careers_url = section.settings.careers_url
  assign fallback_faq_page = pages['faq']
  assign fallback_contact_page = pages['contact']
  assign fallback_careers_page = pages['careers']
  assign brand_text = section.settings.bottom_brand_text | strip
  assign show_locale_selector = false
  assign show_country_selector = false

  if faq_url == blank and fallback_faq_page == blank
    assign fallback_faq_page = pages['faqs']
  endif

  if faq_url == blank and fallback_faq_page == blank
    assign fallback_faq_page = pages['frequently-asked-questions']
  endif

  if faq_url == blank and fallback_faq_page != blank
    assign faq_url = fallback_faq_page.url
  endif

  if contact_url == blank and fallback_contact_page == blank
    assign fallback_contact_page = pages['contact-us']
  endif

  if contact_url == blank and fallback_contact_page != blank
    assign contact_url = fallback_contact_page.url
  endif

  if careers_url == blank and fallback_careers_page == blank
    assign fallback_careers_page = pages['jobs']
  endif

  if careers_url == blank and fallback_careers_page != blank
    assign careers_url = fallback_careers_page.url
  endif

  assign show_location_one = false
  if section.settings.location_1_title != blank or section.settings.location_1_address != blank or section.settings.location_1_directions_url != blank
    assign show_location_one = true
  endif

  assign show_location_two = false
  if section.settings.location_2_title != blank or section.settings.location_2_address != blank or section.settings.location_2_directions_url != blank
    assign show_location_two = true
  endif

  assign show_privacy_policy = false
  if shop.privacy_policy.body != blank
    assign show_privacy_policy = true
  endif

  assign show_terms_of_service = false
  if shop.terms_of_service.body != blank
    assign show_terms_of_service = true
  endif

  assign show_shipping_policy = false
  if shop.shipping_policy.body != blank
    assign show_shipping_policy = true
  endif

  assign show_refund_policy = false
  if shop.refund_policy.body != blank
    assign show_refund_policy = true
  endif

  assign show_support_column = false
  if faq_url != blank or show_privacy_policy or show_terms_of_service or show_shipping_policy or show_refund_policy or contact_url != blank
    assign show_support_column = true
  endif

  assign show_subscribe_column = false
  if section.settings.subscribe_title != blank or section.settings.subscribe_content != blank or careers_url != blank
    assign show_subscribe_column = true
  endif

  assign show_brand_mark = false
  if section.settings.bottom_brand_image != blank or brand_text != blank or shop.name != blank
    assign show_brand_mark = true
  endif

  if brand_text == blank
    assign brand_text = shop.name
  endif

  if section.settings.show_locale_selector and localization.available_languages.size > 1
    assign show_locale_selector = true
  endif

  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign show_country_selector = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .footer__content {
    display: grid;
    gap: clamp(2.5rem, 4vw, 4.75rem);
    padding-block: clamp(2.75rem, 5vw, 5rem);
  }

  #shopify-section-{{ section.id }} .footer__columns {
    display: grid;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .footer__column {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-width: 0;
    padding-block: 1.5rem;
  }

  #shopify-section-{{ section.id }} .footer__column:first-child {
    padding-block-start: 0;
  }

  #shopify-section-{{ section.id }} .footer__column:last-child {
    padding-block-end: 0;
  }

  #shopify-section-{{ section.id }} .footer__column + .footer__column {
    border-block-start: 1px solid rgb(var(--border-color));
  }

  #shopify-section-{{ section.id }} .footer__heading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .footer__address,
  #shopify-section-{{ section.id }} .footer__subscribe-copy {
    max-width: 28rem;
  }

  #shopify-section-{{ section.id }} .footer__link-list {
    display: grid;
    gap: 0.7rem;
  }

  #shopify-section-{{ section.id }} .footer__link-list li {
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .footer__directions {
    margin-block-start: 0.15rem;
    align-self: flex-start;
  }

  #shopify-section-{{ section.id }} .footer__newsletter-shell {
    display: grid;
    gap: 1.15rem;
  }

  #shopify-section-{{ section.id }} .footer__newsletter-form {
    display: grid;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .footer__newsletter-form .form-row {
    display: grid;
    gap: 0.85rem;
  }

  #shopify-section-{{ section.id }} .footer__careers {
    margin-block-start: 1rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid rgb(var(--border-color));
  }

  #shopify-section-{{ section.id }} .footer__brand-mark-wrap {
    padding-block-start: clamp(0.5rem, 3vw, 1.75rem);
  }

  #shopify-section-{{ section.id }} .footer__brand-mark {
    margin: 0;
    max-width: 100%;
    font-family: var(--heading-font-family);
    font-size: clamp(4.25rem, 13vw, 12rem);
    font-style: var(--heading-font-style);
    font-weight: var(--heading-font-weight);
    letter-spacing: var(--heading-letter-spacing);
    line-height: 0.85;
    text-align: center;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .footer__brand-mark-image {
    display: block;
    width: 100%;
    max-width: min(100%, 1200px);
    height: auto;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .footer__aside {
    display: grid;
    gap: 1.65rem;
    justify-content: center;
    padding-block: 1.5rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .footer__aside .social-media {
    --icon-mobile-max-width: 1rem;
    --icon-max-width: 1.25rem;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .footer__column {
      padding: 1.75rem 1.5rem 0 0;
    }

    #shopify-section-{{ section.id }} .footer__column:nth-child(2) {
      border-block-start: 0;
      border-inline-start: 1px solid rgb(var(--border-color));
      padding-inline: 1.5rem 0;
    }

    #shopify-section-{{ section.id }} .footer__column:nth-child(n + 3) {
      border-block-start: 1px solid rgb(var(--border-color));
      padding-block-start: 1.75rem;
    }

    #shopify-section-{{ section.id }} .footer__column:nth-child(3) {
      padding-inline-end: 1.5rem;
    }

    #shopify-section-{{ section.id }} .footer__column:nth-child(4) {
      border-inline-start: 1px solid rgb(var(--border-color));
      padding-inline: 1.5rem 0;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .footer__columns {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.05fr) minmax(0, 1.25fr);
    }

    #shopify-section-{{ section.id }} .footer__column {
      min-height: 100%;
      padding: 0 1.75rem 0 0;
    }

    #shopify-section-{{ section.id }} .footer__column + .footer__column {
      border-block-start: 0;
      border-inline-start: 1px solid rgb(var(--border-color));
      padding-inline: 1.75rem 0;
    }

    #shopify-section-{{ section.id }} .footer__aside {
      align-items: center;
      column-gap: 1rem;
      grid-auto-flow: column;
      padding-block: 2.5rem;
      text-align: start;
    }

    #shopify-section-{{ section.id }} .footer__aside:has(> :nth-child(2)) {
      justify-content: space-between;
    }

    #shopify-section-{{ section.id }} .footer__aside:has(> :nth-child(3)) {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    #shopify-section-{{ section.id }} .footer__aside .social-media {
      justify-content: end;
      order: 99;
    }
  }
</style>

<div class="footer color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container">
    <div class="footer__content">
      <div class="footer__columns">
        {%- if show_location_one -%}
          <div class="footer__column footer__column--location">
            {%- if section.settings.location_1_title != blank -%}
              <p class="footer__heading subheading">{{ section.settings.location_1_title }}</p>
            {%- endif -%}

            {%- if section.settings.location_1_address != blank -%}
              <div class="footer__address prose prose--compact">
                {{- section.settings.location_1_address -}}
              </div>
            {%- endif -%}

            {%- if section.settings.location_1_directions_url != blank -%}
              {%- render 'button',
                content: section.settings.directions_label,
                href: section.settings.location_1_directions_url,
                style: 'outline',
                size: 'sm',
                external: true,
                class: 'footer__directions'
              -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if show_location_two -%}
          <div class="footer__column footer__column--location">
            {%- if section.settings.location_2_title != blank -%}
              <p class="footer__heading subheading">{{ section.settings.location_2_title }}</p>
            {%- endif -%}

            {%- if section.settings.location_2_address != blank -%}
              <div class="footer__address prose prose--compact">
                {{- section.settings.location_2_address -}}
              </div>
            {%- endif -%}

            {%- if section.settings.location_2_directions_url != blank -%}
              {%- render 'button',
                content: section.settings.directions_label,
                href: section.settings.location_2_directions_url,
                style: 'outline',
                size: 'sm',
                external: true,
                class: 'footer__directions'
              -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if show_support_column -%}
          <div class="footer__column footer__column--support">
            {%- if section.settings.customer_service_title != blank -%}
              <p class="footer__heading subheading">{{ section.settings.customer_service_title }}</p>
            {%- endif -%}

            <ul class="footer__link-list unstyled-list" role="list">
              {%- if faq_url != blank -%}
                <li>
                  <a href="{{ faq_url }}" class="link-reversed link-tap-area">{{ section.settings.faq_label }}</a>
                </li>
              {%- endif -%}

              {%- if show_privacy_policy -%}
                <li>
                  <a href="{{ shop.privacy_policy.url }}" class="link-reversed link-tap-area">{{ section.settings.privacy_label }}</a>
                </li>
              {%- endif -%}

              {%- if show_terms_of_service -%}
                <li>
                  <a href="{{ shop.terms_of_service.url }}" class="link-reversed link-tap-area">{{ section.settings.terms_label }}</a>
                </li>
              {%- endif -%}

              {%- if show_shipping_policy -%}
                <li>
                  <a href="{{ shop.shipping_policy.url }}" class="link-reversed link-tap-area">{{ section.settings.shipping_label }}</a>
                </li>
              {%- endif -%}

              {%- if show_refund_policy -%}
                <li>
                  <a href="{{ shop.refund_policy.url }}" class="link-reversed link-tap-area">{{ section.settings.returns_label }}</a>
                </li>
              {%- endif -%}

              {%- if contact_url != blank -%}
                <li>
                  <a href="{{ contact_url }}" class="link-reversed link-tap-area">{{ section.settings.contact_label }}</a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if show_subscribe_column -%}
          <div class="footer__column footer__column--subscribe">
            {%- if section.settings.subscribe_title != blank -%}
              <p class="footer__heading subheading">{{ section.settings.subscribe_title }}</p>
            {%- endif -%}

            <div class="footer__newsletter-shell">
              {%- if section.settings.subscribe_content != blank -%}
                <div class="footer__subscribe-copy prose prose--compact">
                  {{- section.settings.subscribe_content -}}
                </div>
              {%- endif -%}

              {%- assign newsletter_form_id = 'footer-newsletter-' | append: section.id -%}
              {%- assign button_label = section.settings.subscribe_button_label -%}

              {%- if button_label == blank -%}
                {%- assign button_label = 'general.newsletter.subscribe' | t -%}
              {%- endif -%}

              <div class="footer__newsletter-form">
                {%- form 'customer', id: newsletter_form_id, class: 'form-row' -%}
                  {%- if form.posted_successfully? -%}
                    {%- assign success_message = 'general.newsletter.subscribed_successfully' | t -%}
                    {%- render 'banner', content: success_message, status: 'success', text_alignment: 'center' -%}
                  {%- else -%}
                    {%- if form.errors -%}
                      {%- capture error_message -%}{{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}{%- endcapture -%}
                      {%- render 'banner', content: error_message, status: 'error', text_alignment: 'center' -%}
                    {%- endif -%}

                    <input type="hidden" name="contact[tags]" value="newsletter">

                    {%- assign input_label = 'general.newsletter.email' | t -%}
                    {%- render 'input', name: 'contact[email]', label: input_label, type: 'email', required: true, autocomplete: 'email', enterkeyhint: 'send' -%}

                    {%- render 'button', type: 'submit', content: button_label -%}
                  {%- endif -%}
                {%- endform -%}

                {%- if section.settings.newsletter_disclaimer_text != blank -%}
                  <div class="prose text-subdued text-sm">
                    {{- section.settings.newsletter_disclaimer_text -}}
                  </div>
                {%- endif -%}
              </div>

              {%- if careers_url != blank -%}
                <div class="footer__careers">
                  <a href="{{ careers_url }}" class="link-reversed link-tap-area">{{ section.settings.careers_label }}</a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if show_brand_mark -%}
        <div class="footer__brand-mark-wrap">
          {%- if section.settings.bottom_brand_image != blank -%}
            {%- capture brand_sizes -%}min(100vw - 2rem, 1200px){%- endcapture -%}
            {{- section.settings.bottom_brand_image | image_url: width: section.settings.bottom_brand_image.width | image_tag: class: 'footer__brand-mark-image', loading: 'lazy', sizes: brand_sizes, widths: '400,600,800,1000,1200,1400,1600,1800,2000' -}}
          {%- else -%}
            <p class="footer__brand-mark">{{ brand_text }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <hr class="separator full-bleed">

    <div class="footer__aside">
      {%- if show_locale_selector or show_country_selector -%}
        <div class="h-stack gap-5 md:justify-start">
          {%- liquid
            if show_country_selector
              render 'localization-selector', type: 'country', show_country_name: section.settings.show_country_name, show_country_flag: section.settings.show_country_flag
            endif

            if show_locale_selector
              render 'localization-selector', type: 'locale'
            endif
          -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social_media -%}
        {%- render 'social-media' -%}
      {%- endif -%}

      <div class="v-stack gap-3">
        <p class="text-sm">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.show_powered_by_shopify %} {{ powered_by_link }}{% endif %}</p>

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="h-stack gap-4 wrap unstyled-list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{- type | payment_type_svg_tag -}}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "shopify-section--footer",
  "tag": "footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Location one"
    },
    {
      "type": "text",
      "id": "location_1_title",
      "label": "Heading",
      "default": "Northeast"
    },
    {
      "type": "richtext",
      "id": "location_1_address",
      "label": "Address"
    },
    {
      "type": "url",
      "id": "location_1_directions_url",
      "label": "Google Maps directions link"
    },
    {
      "type": "header",
      "content": "Location two"
    },
    {
      "type": "text",
      "id": "location_2_title",
      "label": "Heading",
      "default": "Highland"
    },
    {
      "type": "richtext",
      "id": "location_2_address",
      "label": "Address"
    },
    {
      "type": "url",
      "id": "location_2_directions_url",
      "label": "Google Maps directions link"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Directions button label",
      "default": "Directions"
    },
    {
      "type": "header",
      "content": "Customer service"
    },
    {
      "type": "text",
      "id": "customer_service_title",
      "label": "Heading",
      "default": "Customer Service"
    },
    {
      "type": "text",
      "id": "faq_label",
      "label": "FAQ label",
      "default": "FAQs"
    },
    {
      "type": "url",
      "id": "faq_url",
      "label": "FAQ link override"
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "Privacy label",
      "default": "Privacy Statement"
    },
    {
      "type": "text",
      "id": "terms_label",
      "label": "Terms label",
      "default": "Terms of Service"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping label",
      "default": "Shipping Policy"
    },
    {
      "type": "text",
      "id": "returns_label",
      "label": "Returns label",
      "default": "Returns & Exchange Policy"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact link override"
    },
    {
      "type": "header",
      "content": "Subscribe"
    },
    {
      "type": "text",
      "id": "subscribe_title",
      "label": "Heading",
      "default": "Subscribe"
    },
    {
      "type": "richtext",
      "id": "subscribe_content",
      "label": "Copy",
      "default": "<p>Subscribe to product launches, running updates, and things we think are worth your time. Never spammy.</p>"
    },
    {
      "type": "text",
      "id": "subscribe_button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "richtext",
      "id": "newsletter_disclaimer_text",
      "label": "Disclaimer text",
      "default": "<p>By subscribing, you agree to receive marketing emails from us.</p>"
    },
    {
      "type": "text",
      "id": "careers_label",
      "label": "Careers label",
      "default": "Careers"
    },
    {
      "type": "url",
      "id": "careers_url",
      "label": "Careers link override"
    },
    {
      "type": "header",
      "content": "Bottom brand mark"
    },
    {
      "type": "image_picker",
      "id": "bottom_brand_image",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "bottom_brand_text",
      "label": "Fallback large text",
      "info": "Shown when no image is uploaded."
    },
    {
      "type": "header",
      "content": "Footer extras"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "t:sections.footer.show_social_media",
      "info": "t:sections.footer.show_social_media_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.show_payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by_shopify",
      "label": "t:sections.footer.show_powered_by_shopify",
      "default": true
    },
    {
      "type": "header",
      "content": "t:global.localization.country_region_selector_category",
      "info": "t:global.localization.country_region_selector_category_info"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:global.localization.show_country_region_selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_name",
      "label": "t:global.localization.show_country_name",
      "default": true,
      "visible_if": "{{ section.settings.show_country_selector }}"
    },
    {
      "type": "checkbox",
      "id": "show_country_flag",
      "label": "t:global.localization.show_country_flag",
      "default": true,
      "visible_if": "{{ section.settings.show_country_selector }}"
    },
    {
      "type": "header",
      "content": "t:global.localization.language_selector_category",
      "info": "t:global.localization.language_selector_category_info"
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "t:global.localization.show_locale_selector",
      "default": true
    }
  ]
}
{% endschema %}
