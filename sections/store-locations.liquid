{%- liquid
  assign fallback_map_src = section.settings.default_map_embed | strip

  if fallback_map_src contains 'src="'
    assign fallback_map_src = fallback_map_src | split: 'src="' | last | split: '"' | first
  elsif fallback_map_src contains "src='"
    assign fallback_map_src = fallback_map_src | split: "src='" | last | split: "'" | first
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --store-locations-column-width: {{ section.settings.location_panel_width }}fr;
    --store-map-column-width: {{ 100 | minus: section.settings.location_panel_width }}fr;
    --store-map-height-desktop: {{ section.settings.desktop_map_height }}px;
    --store-map-height-mobile: {{ section.settings.mobile_map_height }}px;
    --store-location-card-padding-block: clamp(1.25rem, 2vw, 2rem);
    --store-location-card-padding-inline: {{ section.settings.location_side_padding }}px;
    --store-location-gap: clamp(1rem, 2vw, 1.5rem);
    --store-location-active-shadow: 0 0 0 2px rgb(var(--text-color));
    --store-location-text-align: {{ section.settings.location_text_alignment }};
  }

  #shopify-section-{{ section.id }} + .shopify-section {
    --section-enable-padding-collapsing: 0;
  }

  #shopify-section-{{ section.id }} .store-locations {
    overflow: hidden;
    max-width: 1200px;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .store-locations__header {
    max-width: 42rem;
    margin-inline: auto;
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .store-locations__header--no-subheading {
    padding-block-start: 0.75rem;
  }

  #shopify-section-{{ section.id }} .store-locations__eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .store-locations__layout {
    display: grid;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .store-locations__list {
    display: grid;
    align-content: start;
    background: rgb(var(--background));
  }

  #shopify-section-{{ section.id }} .store-locations__item {
    display: grid;
    gap: var(--store-location-gap);
    padding-block: var(--store-location-card-padding-block);
    padding-inline: var(--store-location-card-padding-inline);
    border-block-start: 1px solid rgb(var(--border-color));
    background: rgb(var(--store-location-bg, var(--background)));
    color: rgb(var(--store-location-text, var(--text-color)));
    justify-items: var(--store-location-text-align);
    text-align: var(--store-location-text-align);
    cursor: pointer;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }


  #shopify-section-{{ section.id }} .store-locations__item.is-active {
    box-shadow: var(--store-location-active-shadow) inset;
  }

  #shopify-section-{{ section.id }} .store-locations__item:focus-visible {
    outline: 2px solid rgb(var(--text-color));
    outline-offset: -2px;
  }

  #shopify-section-{{ section.id }} .store-locations__name {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .store-locations__content {
    display: grid;
    gap: 1rem;
    justify-items: inherit;
  }

  #shopify-section-{{ section.id }} .store-locations__content .prose > * + * {
    margin-top: 0.85rem;
  }

  #shopify-section-{{ section.id }} .store-locations__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: {% if section.settings.location_text_alignment == 'center' %}center{% elsif section.settings.location_text_alignment == 'end' %}flex-end{% else %}flex-start{% endif %};
  }

  #shopify-section-{{ section.id }} .store-locations__item .button--outline {
    --button-text-color: rgb(var(--store-location-text, var(--text-color)));
    box-shadow: inset 0 0 0 1px rgb(var(--store-location-text, var(--text-color)));
  }

  #shopify-section-{{ section.id }} .store-locations__map-pane {
    position: relative;
    min-height: var(--store-map-height-mobile);
    overflow: hidden;
    background: rgb(var(--text-color) / 0.06);
    border-block-start: 1px solid rgb(var(--border-color));
    isolation: isolate;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .store-locations__map-canvas,
  #shopify-section-{{ section.id }} .store-locations__map-frame,
  #shopify-section-{{ section.id }} .store-locations__map-empty {
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  #shopify-section-{{ section.id }} .store-locations__map-frame {
    border: 0;
  }

  #shopify-section-{{ section.id }} .store-locations__map-empty {
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .store-locations__leaflet-marker {
    background: transparent;
    border: 0;
  }

  #shopify-section-{{ section.id }} .store-locations__map-callout {
    position: relative;
    display: block;
    width: 9rem;
    height: 2.9rem;
    color: #111111;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .store-locations__map-callout-label {
    position: absolute;
    inset-block-end: 0.95rem;
    inset-inline-start: 0.95rem;
    font-size: calc(0.95rem * var(--store-callout-label-scale, 1));
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    text-shadow:
      0 0 2px rgba(255, 255, 255, 0.95),
      0 0 8px rgba(255, 255, 255, 0.95);
  }

  #shopify-section-{{ section.id }} .store-locations__map-callout--left .store-locations__map-callout-label {
    inset-inline-start: auto;
    inset-inline-end: 0.95rem;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .store-locations__map-callout-dot {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
    background: #111111;
    border: 2px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
    flex-shrink: 0;
    transform: scale(var(--store-callout-dot-scale, 1));
    transition: transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .store-locations__map-callout--left .store-locations__map-callout-dot {
    inset-inline-start: auto;
    inset-inline-end: 0;
  }

  #shopify-section-{{ section.id }} .leaflet-control-attribution,
  #shopify-section-{{ section.id }} .leaflet-control-attribution a {
    color: rgb(var(--text-color) / 0.75);
  }

  #shopify-section-{{ section.id }} .leaflet-container,
  #shopify-section-{{ section.id }} .leaflet-pane,
  #shopify-section-{{ section.id }} .leaflet-top,
  #shopify-section-{{ section.id }} .leaflet-bottom,
  #shopify-section-{{ section.id }} .leaflet-control {
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .leaflet-control-attribution {
    background: rgb(var(--background) / 0.82);
    backdrop-filter: blur(4px);
  }

  #shopify-section-{{ section.id }} .leaflet-tile {
    outline: 1px solid transparent;
    backface-visibility: hidden;
  }

  #shopify-section-{{ section.id }} .leaflet-bar {
    border: 1px solid rgb(var(--border-color));
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .leaflet-bar a {
    background: rgb(var(--background));
    color: rgb(var(--text-color));
    border-bottom-color: rgb(var(--border-color));
  }

  #shopify-section-{{ section.id }} .leaflet-bar a:hover {
    background: rgb(var(--background));
    color: rgb(var(--text-color));
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .store-locations__list {
      order: 1;
    }

    #shopify-section-{{ section.id }} .store-locations__map-pane {
      order: 2;
    }

    #shopify-section-{{ section.id }} .store-locations__item {
      justify-items: center;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .store-locations__content {
      justify-items: center;
    }

    #shopify-section-{{ section.id }} .store-locations__content .prose,
    #shopify-section-{{ section.id }} .store-locations__actions {
      justify-content: center;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .store-locations__list {
      border-block-end: 1px solid rgb(var(--border-color));
    }

    #shopify-section-{{ section.id }} .store-locations__map-pane {
      margin-block-start: var(--store-location-card-padding-block);
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .store-locations__layout {
      grid-template-columns: minmax(20rem, var(--store-locations-column-width)) minmax(0, var(--store-map-column-width));
    }

    #shopify-section-{{ section.id }} .store-locations__map-pane {
      min-height: var(--store-map-height-desktop);
      border-block-start: 0;
      border-inline-start: 1px solid rgb(var(--border-color));
    }
  }
</style>

<div
  class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  data-store-locations-section
  data-map-style="light"
  data-marker-color="{{ section.settings.marker_color | escape }}"
  data-show-name-tag="{{ section.settings.show_location_name_tag }}"
  data-name-tag-background="{{ section.settings.location_name_tag_background | escape }}"
  data-name-tag-border="{{ section.settings.location_name_tag_border | escape }}"
>
  <div class="container section-spacing">
    <div class="store-locations">
      <div class="store-locations__header{% if section.settings.subheading == blank %} store-locations__header--no-subheading{% endif %}">
        <div class="v-stack gap-4 sm:gap-6">
          {%- if section.settings.subheading != blank -%}
            <p class="store-locations__eyebrow">{{ section.settings.subheading }}</p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_size, html_tag: 'h2' -%}
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            <div class="prose prose-justify-center mx-auto max-w-lg">
              {{- section.settings.content -}}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="store-locations__layout">
        <div class="store-locations__list">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <article
                class="store-locations__item"
                data-store-location-card
                data-location-index="{{ forloop.index0 }}"
                data-lat="{{ block.settings.latitude | escape }}"
                data-lng="{{ block.settings.longitude | escape }}"
                data-zoom="{{ block.settings.map_zoom }}"
                {% if block.settings.background_color != blank or block.settings.text_color != blank %}
                  style="
                    {%- if block.settings.background_color != blank and block.settings.background_color != 'rgba(0,0,0,0)' -%}
                      --store-location-bg: {{ block.settings.background_color.rgb }};
                    {%- endif -%}
                    {%- if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' -%}
                      --store-location-text: {{ block.settings.text_color.rgb }};
                    {%- endif -%}
                  "
                {% endif %}
                tabindex="0"
                role="button"
                aria-pressed="false"
                {{ block.shopify_attributes }}
              >
                <div class="store-locations__content">
                  {%- if block.settings.location_name != blank -%}
                    <h3 class="store-locations__name {{ section.settings.location_heading_size }}">{{ block.settings.location_name }}</h3>
                  {%- endif -%}

                  {%- if block.settings.address != blank -%}
                    <div class="prose">
                      {{- block.settings.address -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.hours != blank -%}
                    <div class="prose">
                      {{- block.settings.hours -}}
                    </div>
                  {%- endif -%}
                </div>

                <div class="store-locations__actions">
                  {%- if block.settings.directions_url != blank -%}
                    {%- render 'button',
                      content: block.settings.directions_label,
                      href: block.settings.directions_url,
                      style: 'outline',
                      external: true
                    -%}
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          {%- else -%}
            <div class="store-locations__item">
              <div class="prose">
                <p>Add up to two location blocks to build this section.</p>
              </div>
            </div>
          {%- endif -%}
        </div>

        <div class="store-locations__map-pane">
          {%- assign valid_coordinates = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.latitude != blank and block.settings.longitude != blank -%}
              {%- assign valid_coordinates = valid_coordinates | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if valid_coordinates > 0 -%}
            <div
              class="store-locations__map-canvas"
              data-store-map
              data-overview-zoom="{{ section.settings.overview_zoom }}"
              data-default-zoom="{{ section.blocks.first.settings.map_zoom }}"
            ></div>
          {%- else -%}
            {%- assign rendered_block_frames = false -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_embed_src = block.settings.map_embed | strip
                if block_embed_src contains 'src="'
                  assign block_embed_src = block_embed_src | split: 'src="' | last | split: '"' | first
                elsif block_embed_src contains "src='"
                  assign block_embed_src = block_embed_src | split: "src='" | last | split: "'" | first
                endif
              -%}
              {%- if block_embed_src != blank -%}
                <iframe
                  class="store-locations__map-frame"
                  src="{{ block_embed_src | escape }}"
                  data-location-map-frame="{{ forloop.index0 }}"
                  title="Store location map"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                  {% unless forloop.first %}hidden{% endunless %}
                ></iframe>
                {%- assign rendered_block_frames = true -%}
              {%- endif -%}
            {%- endfor -%}

            {%- unless rendered_block_frames -%}
              {%- if fallback_map_src != blank -%}
                <iframe
                  class="store-locations__map-frame"
                  src="{{ fallback_map_src | escape }}"
                  title="Store locations map"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                ></iframe>
              {%- else -%}
                <div class="store-locations__map-empty prose">
                  <p>Add coordinates for your locations, or paste a default map embed.</p>
                </div>
              {%- endif -%}
            {%- endunless -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const tileConfigs = {
      standard: {
        url: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        options: {
          maxZoom: 19,
          subdomains: ['a', 'b', 'c'],
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }
      },
      light: {
        url: 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
        options: {
          maxZoom: 20,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }
      },
      muted: {
        url: 'https://{s}.basemaps.cartocdn.com/voyager/{z}/{x}/{y}{r}.png',
        options: {
          maxZoom: 20,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }
      },
      dark: {
        url: 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
        options: {
          maxZoom: 20,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }
      },
      minimal: {
        url: 'https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png',
        options: {
          maxZoom: 20,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }
      },
      muted_no_labels: {
        url: 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png',
        options: {
          maxZoom: 20,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }
      },
      dark_no_labels: {
        url: 'https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png',
        options: {
          maxZoom: 20,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }
      }
    };

    const loadLeaflet = () => {
      if (window.L) {
        return Promise.resolve(window.L);
      }

      if (window.__codexLeafletPromise) {
        return window.__codexLeafletPromise;
      }

      window.__codexLeafletPromise = new Promise((resolve, reject) => {
        const stylesheetId = 'codex-leaflet-stylesheet';

        if (!document.getElementById(stylesheetId)) {
          const link = document.createElement('link');
          link.id = stylesheetId;
          link.rel = 'stylesheet';
          link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
          link.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
          link.crossOrigin = '';
          document.head.appendChild(link);
        }

        const script = document.createElement('script');
        script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
        script.crossOrigin = '';
        script.async = true;
        script.onload = () => resolve(window.L);
        script.onerror = () => reject(new Error('Leaflet failed to load.'));

        document.head.appendChild(script);
      });

      return window.__codexLeafletPromise;
    };

    const createIcon = (leaflet, title, index, state, color = '#111111', nameTag = null) => {
      let labelStyle = '';
      if (nameTag?.show) {
        const bg = nameTag.background || 'transparent';
        const border = nameTag.border || 'transparent';
        labelStyle = `background:${bg};border:1px solid ${border};padding:0.2em 0.45em;border-radius:2px;text-shadow:none;`;
      }

      return leaflet.divIcon({
      className: 'store-locations__leaflet-marker',
      html: `<span style="
        --store-callout-dot-scale:${state === 'active' ? '1.18' : '1'};
        --store-callout-label-scale:${state === 'overview' ? '0.9' : '1'};
      " class="store-locations__map-callout ${index % 2 === 0 ? 'store-locations__map-callout--right' : 'store-locations__map-callout--left'}">
        <span class="store-locations__map-callout-label" style="${labelStyle}">${title}</span>
        <span class="store-locations__map-callout-dot" style="background:${color};"></span>
      </span>`,
      iconSize: [state === 'active' ? 148 : 140, 46],
      iconAnchor: [index % 2 === 0 ? 7 : 133, 39]
      });
    };

    const getSectionSignature = (section, styleMode, markerMode, cards) => {
      const cardSignature = cards.map((card) => [
        card.dataset.lat || '',
        card.dataset.lng || '',
        card.dataset.locationIndex || ''
      ].join(':')).join('|');

      return [styleMode, markerMode, cardSignature].join('||');
    };

    const destroyMap = (mapElement) => {
      if (mapElement.__storeLocationsMap) {
        mapElement.__storeLocationsMap.remove();
        mapElement.__storeLocationsMap = null;
      }

      if (mapElement._leaflet_id) {
        try {
          delete mapElement._leaflet_id;
        } catch (error) {
          mapElement._leaflet_id = undefined;
        }
      }

      mapElement.removeAttribute('style');
      mapElement.innerHTML = '';
      mapElement.className = 'store-locations__map-canvas';
    };

    const initializeSection = (section) => {
      if (!section) {
        return;
      }

      // If the outer Shopify section wrapper was passed, resolve to the inner data element
      // so that dataset reads (mapStyle, markerColor, etc.) work correctly
      if (!section.hasAttribute('data-store-locations-section')) {
        section = section.querySelector('[data-store-locations-section]');
        if (!section) return;
      }

      const mapElement = section.querySelector('[data-store-map]');
      const cards = Array.from(section.querySelectorAll('[data-store-location-card]'));

      if (cards.length === 0) {
        return;
      }

      // Handle per-block iframe mode when no Leaflet map canvas is present
      const mapFrames = Array.from(section.querySelectorAll('[data-location-map-frame]'));

      if (!mapElement) {
        if (mapFrames.length > 0 && !section.dataset.storeLocationsIframeInit) {
          section.dataset.storeLocationsIframeInit = '1';

          cards.forEach((card) => {
            const activateCard = (event) => {
              if (event.target.closest('a')) return;

              const index = card.dataset.locationIndex;
              mapFrames.forEach((frame) => {
                frame.hidden = frame.dataset.locationMapFrame !== index;
              });

              cards.forEach((c) => {
                const isActive = c === card;
                c.classList.toggle('is-active', isActive);
                c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
              });
            };

            const activateCardWithKeyboard = (event) => {
              if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                activateCard(event);
              }
            };

            card.addEventListener('click', activateCard);
            card.addEventListener('keydown', activateCardWithKeyboard);
          });
        }

        return;
      }

      const styleMode = section.dataset.mapStyle || 'dark';
      const markerColor = section.dataset.markerColor || '#111111';
      const tileConfig = Object.prototype.hasOwnProperty.call(tileConfigs, styleMode) ? tileConfigs[styleMode] : tileConfigs.dark;
      const signature = getSectionSignature(section, styleMode, 'callout', cards);

      if (section.dataset.storeLocationsSignature === signature) {
        return;
      }

      const locations = cards.map((card, index) => {
        const lat = Number.parseFloat(card.dataset.lat || '');
        const lng = Number.parseFloat(card.dataset.lng || '');

        if (Number.isNaN(lat) || Number.isNaN(lng)) {
          return null;
        }

        return {
          index,
          card,
          lat,
          lng,
          zoom: Number.parseInt(card.dataset.zoom || '13', 10),
          title: card.querySelector('.store-locations__name')?.textContent?.trim() || `Location ${index + 1}`
        };
      }).filter(Boolean);

      if (locations.length === 0) {
        return;
      }

      loadLeaflet().then((leaflet) => {
        destroyMap(mapElement);

        const map = leaflet.map(mapElement, {
          zoomControl: true,
          scrollWheelZoom: true,
          dragging: true,
          attributionControl: false
        });

        leaflet.tileLayer(tileConfig.url, tileConfig.options).addTo(map);
        leaflet.control.attribution({ prefix: false }).addTo(map);

        const bounds = leaflet.latLngBounds(locations.map((location) => [location.lat, location.lng]));
        const markers = [];
        let activeLocationIndex = null;

        const fitToOverview = () => {
          const overviewZoom = Number.parseInt(mapElement.dataset.overviewZoom || '11', 10);

          if (locations.length > 1) {
            map.setView(bounds.getCenter(), overviewZoom);
          } else {
            map.setView([locations[0].lat, locations[0].lng], Number.parseInt(mapElement.dataset.defaultZoom || '13', 10));
          }
        };

        const setActiveLocation = (activeIndex) => {
          activeLocationIndex = activeIndex;

          locations.forEach((location) => {
            const isActive = location.index === activeIndex;
            location.card.classList.toggle('is-active', isActive);
            location.card.setAttribute('aria-pressed', isActive ? 'true' : 'false');

            const marker = markers[location.index];
            if (marker) {
              marker.setIcon(createIcon(leaflet, location.title, location.index, isActive ? 'active' : 'inactive', markerColor));
              marker.setZIndexOffset(isActive ? 500 : 0);
            }
          });

          const activeLocation = locations.find((location) => location.index === activeIndex);

          if (activeLocation) {
            map.flyTo([activeLocation.lat, activeLocation.lng], Math.max(map.getZoom(), activeLocation.zoom || 13), {
              animate: true,
              duration: 0.45
            });
          }
        };

        const showOverview = () => {
          activeLocationIndex = null;

          locations.forEach((location) => {
            location.card.classList.remove('is-active');
            location.card.setAttribute('aria-pressed', 'false');

            const marker = markers[location.index];
            if (marker) {
              marker.setIcon(createIcon(leaflet, location.title, location.index, 'overview', markerColor));
              marker.setZIndexOffset(0);
            }
          });

          fitToOverview();
        };

        locations.forEach((location) => {
          const marker = leaflet.marker([location.lat, location.lng], {
            icon: createIcon(leaflet, location.title, location.index, 'overview', markerColor),
            title: location.title
          }).addTo(map);

          marker.on('click', () => {
            if (activeLocationIndex === location.index) {
              showOverview();
              return;
            }

            setActiveLocation(location.index);
          });
          markers[location.index] = marker;

          if (location.card.__storeLocationClickHandler) {
            location.card.removeEventListener('click', location.card.__storeLocationClickHandler);
          }

          if (location.card.__storeLocationKeyHandler) {
            location.card.removeEventListener('keydown', location.card.__storeLocationKeyHandler);
          }

          const activateCard = (event) => {
            if (event.target.closest('a')) {
              return;
            }

            if (activeLocationIndex === location.index) {
              showOverview();
              return;
            }

            setActiveLocation(location.index);
          };

          const activateCardWithKeyboard = (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              setActiveLocation(location.index);
            }
          };

          location.card.__storeLocationClickHandler = activateCard;
          location.card.__storeLocationKeyHandler = activateCardWithKeyboard;

          location.card.addEventListener('click', activateCard);
          location.card.addEventListener('keydown', activateCardWithKeyboard);
        });

        showOverview();
        window.setTimeout(() => map.invalidateSize(), 150);
        mapElement.__storeLocationsMap = map;
        section.dataset.storeLocationsSignature = signature;
      }).catch(() => {
        destroyMap(mapElement);

        mapElement.replaceWith(Object.assign(document.createElement('div'), {
          className: 'store-locations__map-empty prose',
          innerHTML: '<p>Leaflet could not load for this section.</p>'
        }));
      });
    };

    window.__codexInitializeStoreLocationsSection = initializeSection;

    if (!window.__codexStoreLocationsBootstrapped) {
      window.__codexStoreLocationsBootstrapped = true;

      document.addEventListener('shopify:section:load', (event) => {
        const loadedSection = event.target?.querySelector?.('[data-store-locations-section]') || event.target;
        const initializeLoadedSection = window.__codexInitializeStoreLocationsSection;

        if (loadedSection?.matches?.('[data-store-locations-section]') && typeof initializeLoadedSection === 'function') {
          initializeLoadedSection(loadedSection);
        }
      });
    }

    window.__codexInitializeStoreLocationsSection(document.getElementById('shopify-section-{{ section.id }}'));
  })();
</script>

