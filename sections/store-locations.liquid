{%- liquid
  assign fallback_map_src = section.settings.default_map_embed | strip

  if fallback_map_src contains 'src="'
    assign fallback_map_src = fallback_map_src | split: 'src="' | last | split: '"' | first
  elsif fallback_map_src contains "src='"
    assign fallback_map_src = fallback_map_src | split: "src='" | last | split: "'" | first
  endif

  if section.blocks.size > 0
    assign map_count = section.blocks.size
  else
    assign map_count = 1
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --store-locations-column-width: {{ section.settings.location_panel_width }}fr;
    --store-map-column-width: {{ 100 | minus: section.settings.location_panel_width }}fr;
    --store-map-stack-height-desktop: {{ section.settings.desktop_map_height }}px;
    --store-map-height-mobile: {{ section.settings.mobile_map_height }}px;
    --store-map-count: {{ map_count }};
    --store-location-card-padding: clamp(1.5rem, 2vw, 2.5rem);
    --store-location-gap: clamp(1rem, 2vw, 1.5rem);
  }

  #shopify-section-{{ section.id }} + .shopify-section {
    --section-enable-padding-collapsing: 0;
  }

  #shopify-section-{{ section.id }} .store-locations {
    border: 1px solid rgb(var(--border-color));
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .store-locations__header {
    max-width: 42rem;
    margin-inline: auto;
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .store-locations__layout {
    display: grid;
    gap: 0;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .store-locations__list {
    display: grid;
    align-content: start;
    background: rgb(var(--background));
  }

  #shopify-section-{{ section.id }} .store-locations__item {
    display: grid;
    gap: var(--store-location-gap);
    padding: var(--store-location-card-padding);
    border-block-start: 1px solid rgb(var(--border-color));
    background: rgb(var(--store-location-bg, var(--background)));
    color: rgb(var(--store-location-text, var(--text-color)));
  }

  #shopify-section-{{ section.id }} .store-locations__item:first-child {
    border-block-start: 0;
  }

  #shopify-section-{{ section.id }} .store-locations__eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .store-locations__name {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .store-locations__content {
    display: grid;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .store-locations__content .prose > * + * {
    margin-top: 0.85rem;
  }

  #shopify-section-{{ section.id }} .store-locations__item .button--outline {
    --button-text-color: rgb(var(--store-location-text, var(--text-color)));
    box-shadow: inset 0 0 0 1px rgb(var(--store-location-text, var(--text-color)));
  }

  #shopify-section-{{ section.id }} .store-locations__maps {
    display: grid;
    grid-auto-rows: minmax(var(--store-map-height-mobile), 1fr);
    border-block-start: 1px solid rgb(var(--border-color));
  }

  #shopify-section-{{ section.id }} .store-locations__map-pane {
    position: relative;
    min-height: var(--store-map-height-mobile);
    overflow: hidden;
    background: rgb(var(--text-color) / 0.06);
    border-block-start: 1px solid rgb(var(--border-color));
  }

  #shopify-section-{{ section.id }} .store-locations__map-pane:first-child {
    border-block-start: 0;
  }

  #shopify-section-{{ section.id }} .store-locations__map-canvas,
  #shopify-section-{{ section.id }} .store-locations__map-frame,
  #shopify-section-{{ section.id }} .store-locations__map-empty {
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  #shopify-section-{{ section.id }} .store-locations__map-frame {
    border: 0;
  }

  #shopify-section-{{ section.id }} .store-locations__map-empty {
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .store-locations__map-label {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
    z-index: 500;
    padding: 0.5rem 0.75rem;
    background: rgb(var(--background) / 0.88);
    color: rgb(var(--text-color));
    border: 1px solid rgb(var(--border-color));
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    text-align: end;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .leaflet-control-attribution,
  #shopify-section-{{ section.id }} .leaflet-control-attribution a {
    color: rgb(var(--text-color) / 0.75);
  }

  #shopify-section-{{ section.id }} .leaflet-control-attribution {
    background: rgb(var(--background) / 0.82);
    backdrop-filter: blur(4px);
  }

  #shopify-section-{{ section.id }} .leaflet-bar {
    border: 1px solid rgb(var(--border-color));
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .leaflet-bar a {
    background: rgb(var(--background));
    color: rgb(var(--text-color));
    border-bottom-color: rgb(var(--border-color));
  }

  #shopify-section-{{ section.id }} .leaflet-bar a:hover {
    background: rgb(var(--background));
    color: rgb(var(--text-color));
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .store-locations__layout {
      grid-template-columns: minmax(20rem, var(--store-locations-column-width)) minmax(0, var(--store-map-column-width));
    }

    #shopify-section-{{ section.id }} .store-locations__maps {
      min-height: var(--store-map-stack-height-desktop);
      grid-template-rows: repeat(var(--store-map-count), minmax(0, 1fr));
      border-block-start: 0;
      border-inline-start: 1px solid rgb(var(--border-color));
    }

    #shopify-section-{{ section.id }} .store-locations__map-pane {
      min-height: 0;
    }
  }
</style>

<div
  class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  data-store-locations-section
  data-map-style="{{ section.settings.map_style }}"
  data-marker-color="{{ section.settings.marker_color | escape }}"
>
  <div class="container section-spacing">
    <div class="store-locations">
      <div class="store-locations__header">
        <div class="v-stack gap-4 sm:gap-6">
          {%- if section.settings.subheading != blank -%}
            <p class="store-locations__eyebrow">{{ section.settings.subheading }}</p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_size, html_tag: 'h2' -%}
          {%- endif -%}

          {%- if section.settings.content != blank -%}
            <div class="prose prose-justify-center mx-auto max-w-lg">
              {{- section.settings.content -}}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="store-locations__layout">
        <div class="store-locations__list">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <article
                class="store-locations__item"
                {% if block.settings.background_color != blank or block.settings.text_color != blank %}
                  style="
                    {%- if block.settings.background_color != blank and block.settings.background_color != 'rgba(0,0,0,0)' -%}
                      --store-location-bg: {{ block.settings.background_color.rgb }};
                    {%- endif -%}
                    {%- if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' -%}
                      --store-location-text: {{ block.settings.text_color.rgb }};
                    {%- endif -%}
                  "
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <div class="store-locations__content">
                  {%- if block.settings.location_name != blank -%}
                    <h3 class="store-locations__name {{ section.settings.location_heading_size }}">{{ block.settings.location_name }}</h3>
                  {%- endif -%}

                  {%- if block.settings.address != blank -%}
                    <div class="prose">
                      {{- block.settings.address -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.hours != blank -%}
                    <div class="prose">
                      {{- block.settings.hours -}}
                    </div>
                  {%- endif -%}
                </div>

                {%- if block.settings.directions_url != blank -%}
                  {%- render 'button',
                    content: block.settings.directions_label,
                    href: block.settings.directions_url,
                    style: 'outline',
                    external: true
                  -%}
                {%- endif -%}
              </article>
            {%- endfor -%}
          {%- else -%}
            <div class="store-locations__item">
              <div class="prose">
                <p>Add up to two location blocks to build this section.</p>
              </div>
            </div>
          {%- endif -%}
        </div>

        <div class="store-locations__maps">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_map_src = block.settings.map_embed | strip

                if block_map_src contains 'src="'
                  assign block_map_src = block_map_src | split: 'src="' | last | split: '"' | first
                elsif block_map_src contains "src='"
                  assign block_map_src = block_map_src | split: "src='" | last | split: "'" | first
                endif

                if block_map_src == blank
                  assign block_map_src = fallback_map_src
                endif
              -%}

              <div class="store-locations__map-pane">
                {%- if block.settings.location_name != blank -%}
                  <div class="store-locations__map-label">{{ block.settings.location_name }}</div>
                {%- endif -%}

                {%- if block.settings.latitude != blank and block.settings.longitude != blank -%}
                  <div
                    class="store-locations__map-canvas"
                    data-store-map
                    data-lat="{{ block.settings.latitude | escape }}"
                    data-lng="{{ block.settings.longitude | escape }}"
                    data-zoom="{{ block.settings.map_zoom }}"
                    data-title="{{ block.settings.location_name | escape }}"
                  ></div>
                {%- elsif block_map_src != blank -%}
                  <iframe
                    class="store-locations__map-frame"
                    src="{{ block_map_src | escape }}"
                    title="{{ block.settings.location_name | default: 'Store location map' | escape }}"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                  ></iframe>
                {%- else -%}
                  <div class="store-locations__map-empty prose">
                    <p>Add coordinates for the Leaflet map, or paste a map embed for this location.</p>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="store-locations__map-pane">
              <div class="store-locations__map-empty prose">
                <p>Your maps will appear here once you add location blocks.</p>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');

    if (!section) {
      return;
    }

    const mapElements = Array.from(section.querySelectorAll('[data-store-map]'));

    if (mapElements.length === 0) {
      return;
    }

    const styleMode = section.dataset.mapStyle || 'dark';
    const markerColor = section.dataset.markerColor || '#ef4434';

    const tileConfigs = {
      standard: {
        url: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        options: {
          maxZoom: 19,
          subdomains: ['a', 'b', 'c'],
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }
      },
      light: {
        url: 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
        options: {
          maxZoom: 20,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }
      },
      muted: {
        url: 'https://{s}.basemaps.cartocdn.com/voyager/{z}/{x}/{y}{r}.png',
        options: {
          maxZoom: 20,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }
      },
      dark: {
        url: 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',
        options: {
          maxZoom: 20,
          subdomains: 'abcd',
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>'
        }
      }
    };

    const tileConfig = Object.prototype.hasOwnProperty.call(tileConfigs, styleMode) ? tileConfigs[styleMode] : tileConfigs.dark;

    const loadLeaflet = () => {
      if (window.L) {
        return Promise.resolve(window.L);
      }

      if (window.__codexLeafletPromise) {
        return window.__codexLeafletPromise;
      }

      window.__codexLeafletPromise = new Promise((resolve, reject) => {
        const stylesheetId = 'codex-leaflet-stylesheet';

        if (!document.getElementById(stylesheetId)) {
          const link = document.createElement('link');
          link.id = stylesheetId;
          link.rel = 'stylesheet';
          link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
          link.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
          link.crossOrigin = '';
          document.head.appendChild(link);
        }

        const script = document.createElement('script');
        script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
        script.crossOrigin = '';
        script.async = true;
        script.onload = () => resolve(window.L);
        script.onerror = () => reject(new Error('Leaflet failed to load.'));

        document.head.appendChild(script);
      });

      return window.__codexLeafletPromise;
    };

    const createIcon = (leaflet) => leaflet.divIcon({
      className: 'store-locations__leaflet-marker',
      html: `<span style="display:block;width:18px;height:18px;border-radius:999px;background:${markerColor};border:2px solid #ffffff;box-shadow:0 0 0 1px rgba(0,0,0,.15);"></span>`,
      iconSize: [18, 18],
      iconAnchor: [9, 9]
    });

    const renderMaps = (leaflet) => {
      const markerIcon = createIcon(leaflet);

      mapElements.forEach((mapElement) => {
        const lat = Number.parseFloat(mapElement.dataset.lat || '');
        const lng = Number.parseFloat(mapElement.dataset.lng || '');
        const zoom = Number.parseInt(mapElement.dataset.zoom || '14', 10);

        if (Number.isNaN(lat) || Number.isNaN(lng)) {
          return;
        }

        const map = leaflet.map(mapElement, {
          zoomControl: true,
          scrollWheelZoom: true,
          dragging: true,
          attributionControl: true
        }).setView([lat, lng], zoom);

        leaflet.tileLayer(tileConfig.url, tileConfig.options).addTo(map);

        leaflet.marker([lat, lng], {
          icon: markerIcon,
          title: mapElement.dataset.title || 'Location'
        }).addTo(map);
      });
    };

    loadLeaflet().then(renderMaps).catch(() => {
      mapElements.forEach((mapElement) => {
        mapElement.replaceWith(Object.assign(document.createElement('div'), {
          className: 'store-locations__map-empty prose',
          innerHTML: '<p>Leaflet could not load for this section.</p>'
        }));
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Store locations",
  "tag": "section",
  "class": "shopify-section--store-locations",
  "max_blocks": 2,
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Visit us"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Meet us in store"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "display-xl", "label": "Display XL" },
        { "value": "display-l", "label": "Display L" },
        { "value": "display-m", "label": "Display M" },
        { "value": "h1", "label": "XX-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-Small" },
        { "value": "h7", "label": "XX-Small" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Intro text",
      "default": "<p>Share your store locations, hours, and directions in one clean section.</p>"
    },
    {
      "type": "range",
      "id": "location_panel_width",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Desktop width for location list",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_map_height",
      "min": 480,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Desktop total map height",
      "default": 760
    },
    {
      "type": "range",
      "id": "mobile_map_height",
      "min": 240,
      "max": 640,
      "step": 20,
      "unit": "px",
      "label": "Mobile height per map",
      "default": 320
    },
    {
      "type": "select",
      "id": "map_style",
      "label": "Map style",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "muted", "label": "Muted" },
        { "value": "light", "label": "Light" },
        { "value": "standard", "label": "Standard" }
      ],
      "default": "dark"
    },
    {
      "type": "color",
      "id": "marker_color",
      "label": "Marker color",
      "default": "#ef4434"
    },
    {
      "type": "textarea",
      "id": "default_map_embed",
      "label": "Default map embed URL or iframe code",
      "info": "Optional fallback used when a location does not have coordinates or its own embed."
    },
    {
      "type": "select",
      "id": "location_heading_size",
      "label": "Location heading size",
      "options": [
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" }
      ],
      "default": "h3"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "location_name",
          "label": "Location name",
          "default": "Downtown"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Card background color"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Card text color"
        },
        {
          "type": "richtext",
          "id": "address",
          "label": "Address",
          "default": "<p>123 Main Street<br>Minneapolis, Minnesota 55401</p>"
        },
        {
          "type": "richtext",
          "id": "hours",
          "label": "Hours",
          "default": "<p>Mon - Fri, 10am - 7pm<br>Saturday, 9am - 5pm<br>Sunday, 11am - 4pm</p>"
        },
        {
          "type": "url",
          "id": "directions_url",
          "label": "Directions link"
        },
        {
          "type": "text",
          "id": "directions_label",
          "label": "Directions label",
          "default": "Directions"
        },
        {
          "type": "text",
          "id": "latitude",
          "label": "Latitude",
          "info": "Used for the Leaflet map."
        },
        {
          "type": "text",
          "id": "longitude",
          "label": "Longitude",
          "info": "Used for the Leaflet map."
        },
        {
          "type": "range",
          "id": "map_zoom",
          "min": 10,
          "max": 18,
          "step": 1,
          "label": "Map zoom",
          "default": 14
        },
        {
          "type": "textarea",
          "id": "map_embed",
          "label": "Fallback map embed URL or iframe code",
          "info": "Used only if coordinates are missing."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store locations",
      "blocks": [
        {
          "type": "location"
        },
        {
          "type": "location",
          "settings": {
            "location_name": "Uptown"
          }
        }
      ]
    }
  ]
}
{% endschema %}
